# =============================================================================
# OpenAlex ETL Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# --- PostgreSQL Database Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openalex_dw
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- OpenAlex API Configuration ---
# Provide your email to access the "polite pool" (recommended, not required)
# This gives better rate limit handling from the OpenAlex team.
OPENALEX_EMAIL=your_email@example.com

# --- ETL Pipeline Configuration ---
# Target number of unique works to load into fact_works
TARGET_WORKS=500000

# Number of works to fetch per API request (max 200)
BATCH_SIZE=200

# Maximum retries on API rate limit (429) errors
MAX_RETRIES=7

# Base wait time in seconds for exponential backoff
BASE_WAIT_SECONDS=1
